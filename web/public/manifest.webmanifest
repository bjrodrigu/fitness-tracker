{
  "name": "Training Journal",
  "short_name": "Journal",
  "description": "A training log for running and lifting.",
  "id": "/",
  "start_url": "/training",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f4f5f2",
  "theme_color": "#f4f5f2",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Log a run", "url": "/entries/new?type=RUN", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Log a lift", "url": "/entries/new?type=STRENGTH", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
