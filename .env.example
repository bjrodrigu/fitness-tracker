# Copy to .env (gitignored) to override the defaults in docker-compose.yml.

# A read-only demo account with generated sample data. Set to false to turn it off.
DEMO_DATA=true

# Use your own MongoDB (e.g. Atlas) instead of the local container.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/
# MONGODB_DATABASE=training_journal

# Dates ("today", week boundaries) use this time zone. Defaults to UTC.
# TZ=America/New_York

# Port for the web app on this machine.
WEB_PORT=4000

# Turns on "Link Garmin" and the scheduled Garmin sync. 32 random bytes, base64. Make one with:
#   openssl rand -base64 32
# Keep it secret; if it changes, everyone has to link Garmin again.
# GARMIN_TOKEN_KEY=

# How often linked Garmin accounts sync (ISO-8601 duration). Default every 6 hours.
# GARMIN_SYNC_EVERY=PT6H
